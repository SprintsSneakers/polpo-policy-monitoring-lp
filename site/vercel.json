{
  "trailingSlash": true,
  "redirects": [
    { "source": "/nl", "destination": "/nl-be/", "permanent": true },
    { "source": "/be-nl", "destination": "/nl-be/", "permanent": true }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Strict-Transport-Security", "value": "max-age=63072000" },
        { "key": "X-Content-Type-Options", "value": "nosniff" }
      ]
    }
  ]
}
